<?xml version="1.0" encoding="utf-8"?>
<!--
  Web Deploy to a SmarterASP.NET site. Run it through deploy/smarterasp/publish.ps1, which builds
  the PWA into wwwroot first and passes the site's own values: MSDeployServiceURL,
  DeployIisAppPath, UserName and Password from the downloaded .publishsettings, and
  ServerSettingsFile, the site's appsettings.Local.json. None of them belong in Git.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <SelfContained>false</SelfContained>
    <!-- Out of process: a SmarterASP subsite shares its IIS application pool with the account's
         other sites, and a pool cannot mix hosting models (HTTP 500.34) nor hold two in-process
         apps (500.35). IIS forwards to the app's own Kestrel process instead. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <AuthType>Basic</AuthType>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <!-- IIS holds the running app's DLLs open; app_offline.htm stops it for the copy. -->
    <EnableMSDeployAppOffline>true</EnableMSDeployAppOffline>
    <!-- Never delete what only the server has: the data-protection keys and the stdout logs. -->
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
  </PropertyGroup>

  <ItemGroup Condition="'$(ServerSettingsFile)' != ''">
    <ResolvedFileToPublish Include="$(ServerSettingsFile)">
      <RelativePath>appsettings.Local.json</RelativePath>
    </ResolvedFileToPublish>
  </ItemGroup>
</Project>
