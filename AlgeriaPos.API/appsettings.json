{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "StartupWaitSeconds": 60
  },
  "ConnectionStrings": {
    "Default": "Data Source=pos.db"
  },
  "Jwt": {
    "Key": "",
    "Issuer": "pos-api",
    "Audience": "pos-app",
    "ExpiryDays": 30,
    "OfficeSessionHours": 10
  },
  "Proxy": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
