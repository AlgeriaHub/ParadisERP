<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.11" />
    <!-- /health has to know whether the company database answers, not just whether the
         process is alive: AddDbContextCheck<PosDbContext> is in this package. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Sentry.AspNetCore" Version="6.12.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <!-- appsettings.Local.json is this machine's own settings (a local database, say). A publish
       must never carry it to a server: the server keeps its own, and a Web Deploy that shipped
       this one would point the live site at a database on the developer's laptop. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json;appsettings.Local.example.json" CopyToPublishDirectory="Never" />
    <!-- Nor the Development settings (security review, 2026-10-10): they hold the development
         signing key, which would become the live one if the site ever started as Development. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlgeriaPos.Application\AlgeriaPos.Application.csproj" />
    <ProjectReference Include="..\AlgeriaPos.Infrastructure\AlgeriaPos.Infrastructure.csproj" />
    <ProjectReference Include="..\AlgeriaPos.Migrations.SqlServer\AlgeriaPos.Migrations.SqlServer.csproj" />
  </ItemGroup>
</Project>
