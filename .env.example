# Overrides for the single-container docker-compose.yml at the repository root (a laptop trial).
# Production has its own, with every name a real deployment needs: deploy/prod/.env.example.
Jwt__Key=replace-with-at-least-32-random-characters
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=Sqlite
ConnectionStrings__Default=Data Source=/data/pos.db
# A file database outside Development has to be asked for by name.
Database__AllowSqliteInProduction=true
# The first administrator, read only while the Users table is empty. At least 12 characters.
Bootstrap__AdminUsername=admin
Bootstrap__AdminPassword=replace-with-at-least-twelve-characters
