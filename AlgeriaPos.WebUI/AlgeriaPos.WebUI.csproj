<!-- IDE shim: the Angular PWA is visible in AlgeriaPos.sln, while npm remains its build tool. -->
<Project Sdk="Microsoft.Build.NoTargets">
  <PropertyGroup>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <None Include="angular.json" />
    <None Include="package.json" />
    <None Include="tsconfig*.json" />
    <None Include="src\**\*" />
    <None Include="public\**\*" />
  </ItemGroup>
</Project>
