{
  "realm": "pos",
  "enabled": true,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12)",
  "clients": [
    {
      "clientId": "pos-web",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${POS_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://ops.localhost:5080/signin-oidc", "http://shop.localhost:5080/signin-oidc"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "id": "00000000-0000-4000-8000-000000000001",
      "username": "operator",
      "enabled": true,
      "firstName": "Platform",
      "lastName": "Operator",
      "credentials": [{ "type": "password", "value": "${POS_OPERATOR_PASSWORD}", "temporary": false }]
    },
    {
      "id": "00000000-0000-4000-8000-000000000002",
      "username": "owner",
      "enabled": true,
      "firstName": "Company",
      "lastName": "Owner",
      "credentials": [{ "type": "password", "value": "${POS_OWNER_PASSWORD}", "temporary": false }]
    }
  ]
}
