# ---- built PWA copied into the API for single-process deployment ----
ParadisERP.API/wwwroot/*
!ParadisERP.API/wwwroot/.gitkeep

# ---- editors / OS ----
.vs/
.idea/
.DS_Store
Thumbs.db

# Agent worktrees are local scratch, never repo content.
.claude/worktrees/

# Throwaway screenshots from driving the back office in a browser.
artifacts/backoffice-ui/
artifacts/books-ui/
artifacts/rentals-ui/

# Design screenshots, regenerated on demand by tests/e2e/design-shots.cjs
artifacts/design/

# Printed documents, regenerated on demand by tests/e2e/print-documents.cjs
artifacts/print/

# Local API/mock logs written while driving the built app; never part of the repository.
artifacts/*.log

# DevTools audit output (report + screenshots), reproduced by the script, never reviewed as source.
artifacts/devtools/

# ---- uploaded files (logos, contract scans): kept outside the database and the repo ----
ParadisERP.API/App_Data/

